PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/nepalcan_followup
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret
COMMERCE_EMAIL=
COMMERCE_PASSWORD=
COMMERCE_API_BASE=https://commerce.thecanbrand.com/api/marketplace-orders
CONTACTS_PER_SYNC=20
MAX_SYNC_PAGES=100
# Existing AUTH_EMAIL / AUTH_PASSWORD variables also work for commerce sync.
# Optional explicit legacy portal-user login (local employee login is the default):
ALLOW_PORTAL_LOGIN=false
# Existing logistics integration configuration, if used:
NCM_API_BASE=
NCM_API_TOKEN=

# Initial owner account, used only when it does not already exist:
ADMIN_EMAIL=
ADMIN_PASSWORD=
